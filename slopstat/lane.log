import json, glob
files=glob.glob('*/*.jsonl')
# collect type counts and content shapes
from collections import Counter
tc=Counter()
assistant_content_shapes=Counter()
user_content_shapes=Counter()
sessions=set()
for f in files:
    sessions.add(f)
    with open(f) as fh:
        for line in fh:
            line=line.strip()
            if not line: continue
            try:
                o=json.loads(line)
            except: continue
            tc[o.get('type')]+=1
            if o.get('type')=='assistant':
                c=o.get('message',{}).get('content')
                if isinstance(c,list):
                    assistant_content_shapes[tuple(sorted({b.get('type') for b in c if isinstance(b,dict)}))]+=1
                else:
                    assistant_content_shapes[('NONLIST',type(c).__name__)]+=1
            if o.get('type')=='user':
                c=o.get('message',{}).get('content')
                if isinstance(c,str): user_content_shapes[('str',)]+=1
                elif isinstance(c,list):
                    user_content_shapes[tuple(sorted({b.get('type') for b in c if isinstance(b,dict)}))]+=1
                else: user_content_shapes[('OTHER',type(c).__name__)]+=1
print("files", len(files))
print("type counts", tc)
print("sessions", len(sessions))
print("assistant shapes", assistant_content_shapes)
print("user shapes", user_content_shapes)
